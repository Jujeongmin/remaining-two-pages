node_modules/
dist/
dist-ssr/
*.local

# 로그
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 편집기
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
